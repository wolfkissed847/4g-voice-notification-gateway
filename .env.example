# ===== GSM / 4G Module Configuration (SIM ตัวเดียว) =====
GSM_SERIAL_PORT=/dev/ttyUSB2
GSM_BAUDRATE=115200

# ===== Database =====
# dev บนเครื่องตัวเอง: path relative (ไฟล์ gateway.db อยู่ที่ root ของ repo)
DATABASE_URL=sqlite:///./gateway.db
# บน Pi ใน Docker: ต้องชี้เข้าโฟลเดอร์ที่เมานต์ไว้ ไม่งั้นข้อมูลหายตอน container recreate
# (สังเกต 4 slash = absolute path) — ดู volumes ใน docker-compose.yml
# DATABASE_URL=sqlite:////app/data/gateway.db
# เวลารอเมื่อ DB ถูกล็อกโดยอีก thread ก่อนจะยอมแพ้ (ms) — worker กับ API ใช้ไฟล์เดียวกัน
SQLITE_BUSY_TIMEOUT_MS=5000

# ===== API Security (สำหรับ /notify ที่ระบบ/บอร์ดภายนอกยิงเข้ามา) =====
API_SECRET_KEY=changeme-generate-a-random-string

# ===== Dashboard Auth (single-user login) =====
ADMIN_USERNAME=admin
# สร้างด้วย: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=changeme-generate-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ===== CORS (Next.js dashboard) =====
DASHBOARD_ORIGIN=http://localhost:3000

# ===== Encryption Key (bootstrap only, เผื่ออนาคตเพิ่ม secret ที่ต้อง encrypt) =====
# สร้างด้วย: python scripts/generate_encryption_key.py
ENCRYPTION_KEY=

# ===== TTS Settings =====
TTS_LANGUAGE=th
AUDIO_CACHE_DIR=./audio_cache

# ===== Escalation / Contacts =====
# ตัวอย่างเบอร์โทร - ห้ามใส่เบอร์จริงในไฟล์นี้ ใส่จริงใน .env เท่านั้น
# กำหนดเป็น JSON list เรียงตามลำดับ escalation ต่อกลุ่ม
NETWORK_TEAM_CONTACTS=["+66800000001","+66800000002"]
POWER_TEAM_CONTACTS=["+66800000003"]
