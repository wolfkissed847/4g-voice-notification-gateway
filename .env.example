# ===== GSM / 4G Module Configuration =====
GSM_SERIAL_PORT=/dev/ttyUSB2
GSM_BAUDRATE=115200

# ===== Call Backend Selector =====
# เลือกว่าจะโทรผ่านช่องทางไหน: "gsm" (ซิมธรรมดา) หรือ "voip" (Asterisk + Zadarma)
CALL_BACKEND=gsm

# ===== VoIP: Asterisk AMI =====
# raspberry pi ต่อ LAN ออฟฟิศ, asterisk รันบนเครื่องเดียวกันหรือแยกในวง LAN
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=changeme-ami-user
AMI_SECRET=changeme-generate-a-random-string

# ===== VoIP: Zadarma SIP Trunk =====
# ชื่อ trunk/endpoint ต้องตรงกับที่ตั้งไว้ใน pjsip.conf (ดู asterisk_config/pjsip.conf.example)
ZADARMA_TRUNK_NAME=zadarma-trunk
VOIP_DIAL_CONTEXT=from-gateway
VOIP_CALLERID=IT-Alert

# ===== Database =====
DATABASE_URL=sqlite:///./gateway.db

# ===== API Security (สำหรับ /notify ที่ระบบภายนอกยิงเข้ามา) =====
API_SECRET_KEY=changeme-generate-a-random-string

# ===== Dashboard Auth (single-user login) =====
ADMIN_USERNAME=admin
# สร้างด้วย: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=changeme-generate-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ===== CORS (Next.js dashboard) =====
DASHBOARD_ORIGIN=http://localhost:3000

# ===== Encryption Key (bootstrap only) =====
# สร้างด้วย: python scripts/generate_encryption_key.py
# ใช้ encrypt ค่าความลับที่กรอกผ่าน dashboard (Zadarma/AMI credential) ก่อนเก็บลง DB
ENCRYPTION_KEY=

# ===== Call Logic Settings =====
CALL_RETRY_COUNT=2
CALL_RETRY_DELAY_SECONDS=30
CALL_RING_TIMEOUT_SECONDS=25

# ===== SMS Fallback =====
SMS_FALLBACK_ENABLED=true
SMS_MAX_LENGTH=70

# ===== TTS Settings =====
TTS_LANGUAGE=th
AUDIO_CACHE_DIR=./audio_cache

# ===== Escalation / Contacts =====
# ตัวอย่างเบอร์โทร - ห้ามใส่เบอร์จริงในไฟล์นี้ ใส่จริงใน .env เท่านั้น
# กำหนดเป็น JSON list เรียงตามลำดับ escalation ต่อกลุ่ม
NETWORK_TEAM_CONTACTS=["+66800000001","+66800000002"]
POWER_TEAM_CONTACTS=["+66800000003"]
