# ===== GSM / 4G Module Configuration (SIM ตัวเดียว) =====
#
# /dev/ttyUSB2 = โมดูลที่เสียบผ่าน USB (บอร์ด Waveshare)
# /dev/serial0 = โมดูลเปล่าที่ต่อผ่านหัว GPIO ของ Pi
#                (ต้องเปิด enable_uart=1 + dtoverlay=disable-bt ใน config.txt ก่อน)
#
# ค่านี้เป็นแค่ "พอร์ตที่ให้ลองก่อน" ไม่ใช่คำสั่งตายตัว — ถ้าพอร์ตนี้ไม่ตอบคำสั่ง AT
# ระบบจะไล่หาเองทั้ง /dev/ttyUSB* และ /dev/serial0 แล้วสลับไปใช้ตัวที่ตอบ
GSM_SERIAL_PORT=/dev/ttyUSB2
GSM_BAUDRATE=115200

# ── คุมไฟโมดูลผ่าน GPIO (เฉพาะโมดูลที่ต่อผ่านหัว GPIO เท่านั้น) ──────────────
#
# ปิดไว้เป็นค่าเริ่มต้นโดยตั้งใจ — โมดูลที่เสียบ USB ไม่มีขาพวกนี้ให้แตะ และถ้าเปิดทิ้งไว้
# บนเครื่องที่ต่อสายไม่ตรง จะกลายเป็นการไปแตะขาที่อุปกรณ์อื่นใช้อยู่
# (ตั้งแต่ 21 ส.ค. 2569 ระบบกันให้อีกชั้นแล้ว: จะแตะขา GPIO ก็ต่อเมื่อพอร์ตที่ใช้งาน
#  อยู่จริงคือ /dev/serial0 เท่านั้น)
#
# เลขที่ใส่คือ "เลข GPIO" ไม่ใช่ "เลขขาบนหัวต่อ" — คนละระบบกัน
#     GPIO18 = pin 12       GPIO24 = pin 18
# ดูวิธีต่อสายทั้งหมดที่ docs/HARDWARE_GPIO.md
GSM_GPIO_ENABLED=false
GSM_GPIO_CHIP=0
GSM_GPIO_PWRKEY=18
GSM_GPIO_STATUS=24
# หมายเหตุ: ไม่มี GSM_GPIO_RESET — ต่อขา RESET เข้า GPIO แล้วโมดูลไม่ยอมบูต
# จึงถอดออกจากโค้ดแล้ว ใส่ไว้ใน .env ก็ไม่มีผลอะไร

# ===== Database =====
# ค่านี้ใช้เฉพาะตอนรันบนเครื่องตัวเอง (dev) — ไฟล์ gateway.db อยู่ที่ root ของ repo
#
# ⚠️ บน Pi ใน Docker ไม่ต้องแก้บรรทัดนี้ และแก้ไปก็ไม่มีผล
#    docker-compose.yml บังคับเป็น sqlite:////app/data/gateway.db ทับให้อยู่แล้ว
#    (environment: ทับ env_file: เสมอ) เพราะ path แบบ relative จะชี้ไปในตัว container
#    ซึ่งไม่ได้เมานต์กับดิสก์ → ฐานข้อมูลหายทุกครั้งที่ deploy
DATABASE_URL=sqlite:///./gateway.db
# เวลารอเมื่อ DB ถูกล็อกโดยอีก thread ก่อนจะยอมแพ้ (ms) — worker กับ API ใช้ไฟล์เดียวกัน
SQLITE_BUSY_TIMEOUT_MS=5000

# ===== API Security (สำหรับ /notify ที่ระบบ/บอร์ดภายนอกยิงเข้ามา) =====
API_SECRET_KEY=changeme-generate-a-random-string

# ===== Dashboard Auth (single-user login) =====
ADMIN_USERNAME=admin
# สร้างด้วย: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=changeme-generate-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ===== CORS (Vite/React dashboard) =====
DASHBOARD_ORIGIN=http://localhost:5173

# ===== Encryption Key (bootstrap only, เผื่ออนาคตเพิ่ม secret ที่ต้อง encrypt) =====
# สร้างด้วย: python scripts/generate_encryption_key.py
ENCRYPTION_KEY=

# ===== TTS Settings =====
TTS_LANGUAGE=th
AUDIO_CACHE_DIR=./audio_cache


# หน้าเอกสาร API อัตโนมัติ (/docs, /redoc) — ปิดไว้เป็นค่าเริ่มต้นเพราะไม่มีการยืนยันตัวตนกั้น
# และระบบนี้เปิดออกอินเทอร์เน็ต เปิดเฉพาะตอนพัฒนาบนเครื่องตัวเองเท่านั้น
ENABLE_API_DOCS=false
