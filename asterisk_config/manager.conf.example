; ===================================================================
; manager.conf.example — เปิด AMI ให้ Python เชื่อมต่อได้
; คัดลอกไปเป็น /etc/asterisk/manager.conf บนเครื่อง Asterisk จริง แล้วแทนที่ค่าจริง
; ===================================================================

[general]
enabled = yes
port = 5038
bindaddr = 127.0.0.1
; ถ้า Python รันคนละเครื่องในวง LAN เดียวกัน ให้เปลี่ยนเป็น bindaddr = 0.0.0.0
; และจำกัด permit ด้านล่างให้เฉพาะ IP ของเครื่องที่รัน Python เท่านั้น

[<AMI_USERNAME>]
secret = <AMI_SECRET>
permit = 127.0.0.1/255.255.255.255
read = system,call,log,verbose,command,agent,user
write = system,call,log,verbose,command,agent,user
